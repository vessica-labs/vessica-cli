# One physical Postgres server, with separate logical databases and roles.
VES_POSTGRES_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
VES_CONTROL_DATABASE_PASSWORD=vessica_control_dev
VES_KNOWLEDGE_DATABASE_PASSWORD=vessica_knowledge_dev
VES_CONTROL_DATABASE_URL=postgres://vessica_control_user:vessica_control_dev@127.0.0.1:5432/vessica_control?sslmode=disable
VES_KNOWLEDGE_DATABASE_URL=postgres://vessica_knowledge_user:vessica_knowledge_dev@127.0.0.1:5432/vessica_knowledge?sslmode=disable

# Remote MCP and cloud agents. Production MCP requires a canonical HTTPS
# origin; never store OAuth tokens here.
VES_MCP_ENABLED=false
VES_MCP_PUBLIC_URL=https://vessica.example
VES_MCP_ALLOWED_ORIGINS=https://chatgpt.com
VES_CLOUD_AGENTS_ENABLED=false
VES_COS_AGENT_ID=
VES_NEWSLETTER_AGENT_ID=
VES_CLOUD_AGENT_TIMEZONE=America/Los_Angeles
